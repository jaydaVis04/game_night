{
  "name": "victory-club",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first game night leaderboard for your favorite people.",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build",
    "setup": "node scripts/setup.js",
    "backup": "node scripts/backup.js",
    "reset-admin": "node scripts/reset-admin.js"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.2.0",
    "@fontsource/dm-sans": "^5.2.0",
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0"
  }
}
